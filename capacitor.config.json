{
  "appId": "com.pixelwind.technologies",
  "appName": "AP VidyaConnect",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2400,
      "launchAutoHide": true,
      "backgroundColor": "#F5F9FE",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B1F46"
    }
  }
}
